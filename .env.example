SEED_ADMIN_NAME=DATAVERSE Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Required for participant registration
MONGODB_URI=

# Amazon SES email delivery for participant login and ID verification.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional when using temporary AWS credentials.
AWS_SESSION_TOKEN=
# Verified SES sender identity, for example DATAVERSE 2K26 <noreply@example.com>
SES_FROM_EMAIL=
SES_REPLY_TO_EMAIL=
# Optional SES configuration set for delivery events/metrics.
SES_CONFIGURATION_SET=

# Enable person-ID lookup only after the organisers announce the retrieval date/time.
# This date controls ID display only; participant login is not date-gated.
DATAVERSE_ID_LOOKUP_ENABLED_AT=

# At least 32 random characters. Example generation: openssl rand -hex 32
OTP_HASH_SECRET=
