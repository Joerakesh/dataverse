SEED_ADMIN_NAME=DATAVERSE Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Required for participant registration
MONGODB_URI=

# Participant login and person-ID verification use OTP delivery.
# Keep these SMS credentials and the hash secret configured for cross-device login.

# Enable person-ID lookup only after the organisers announce the retrieval date/time.
# This date controls ID display only; participant login is not date-gated.
DATAVERSE_ID_LOOKUP_ENABLED_AT=

# Required before ID lookup can send verification codes (Twilio SMS).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# At least 32 random characters. Example generation: openssl rand -hex 32
OTP_HASH_SECRET=
